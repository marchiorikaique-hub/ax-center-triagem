# Copie para .env.local e cole sua chave para ligar a IA na busca em linguagem natural.
# Sem chave, a busca funciona no modo determinístico (perguntas comuns já respondem).
OPENAI_API_KEY=
# Modelos (troque à vontade). O barato resolve a tradução de pergunta -> filtro.
OPENAI_MODEL=gpt-5.4-mini
# Prazo de atendimento da prioridade Crítica, em horas.
# O e-mail da coordenação diz 24, o procedimento diz 48, a base grava 72. Assunto em aberto.
# Default = 24 (o que a coordenação cobra da rede). Mude aqui para ver o efeito nos alertas.
SLA_CRITICA_HORAS=24
